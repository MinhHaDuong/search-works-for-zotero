      "async function getFullStructure(pdfDocument, onnxRuntimeProvider, modelProvider, options = {}) {\n\tconst pageCount = pdfDocument.numPages;",
      "\t// Block transformations\n\twrapListItems(structure);",
      "\tlet structureIndex = createStructureIndex(structure, options.structureIndex);",
      "\tlet annotLinkRefs = getAnnotLinkRefs(structure, linkMap, structureIndex);",
      "\tlet parsedLinkRefs = getParsedLinkRefs(structure, structureIndex);",
      "\tlet candidateReferenceLists = getReferenceLists(structure, regularWordsSet);",
      "\tlet candidateReferenceIndex = getReferenceIndex(candidateReferenceLists, regularWordsSet);",
      "\tlet referenceLists = getSupportedReferenceLists(structure, candidateReferenceIndex, structureIndex);",
      "\tlet referenceIndex = getReferenceIndex(referenceLists, regularWordsSet);",
      "\tlet citationRefs = getCitationRefs(structure, referenceIndex, annotLinkRefs, structureIndex);",
      "\tlet figures = getFigures(structure);",
      "\tlet mathBlocks = getMathBlocks(structure);",
      "\tgetFigureAndMathCandidates(structure, candidateGroups, figures, mathBlocks, structureIndex);",
      "\tapplyRefs(structure, citationRefs);",
      "\tlet outline = await getOutline(structure.content, referenceTitleRefs, pdfDocument);",
      "\tcleanupBlockMetrics(structure);",
      "\tensureBlockPageRects(structure);",
      "\tonProgress(95);\n\tlet buffer = packStructuredDocumentText(structure, {",
      "\tonProgress(100);\n\treturn { buf: buffer };"
    ],
